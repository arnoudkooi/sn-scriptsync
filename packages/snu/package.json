{
  "name": "@snutils/snu",
  "version": "0.1.4",
  "description": "Unified CLI and Model Context Protocol (MCP) server for SN Utils and ScriptSync",
  "author": "Arnoud Kooi <arnoud@snutils.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "snu": "bin/snu.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.json",
    "test": "node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "servicenow",
    "sn-utils",
    "scriptsync",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "cursor",
    "claude-code",
    "windsurf"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "@types/ws": "^8.5.14",
    "typescript": "^5.7.3"
  }
}
