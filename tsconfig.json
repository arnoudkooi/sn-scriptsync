{
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "ES2020",
		"outDir": "out",
		"lib": ["ES2020"],
		"sourceMap": true,
		"rootDir": "src",
		"incremental": true,
		"tsBuildInfoFile": "out/.tsbuildinfo"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "node_modules.nosync", ".vscode-test", "autocomplete", "scripts", "packages"]
}
